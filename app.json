{
  "expo": {
    "name": "Hermes Mini",
    "slug": "hermes-mini",
    "version": "0.1.2",
    "orientation": "portrait",
    "scheme": "hermes-mini",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.carpincho.hermesmini"
    },
    "android": {
      "package": "dev.carpincho.hermesmini",
      "adaptiveIcon": {
        "backgroundColor": "#09090b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Hermes Mini usa tus fotos para adjuntarlas al chat.",
          "cameraPermission": "Hermes Mini usa la cámara para adjuntar fotos al chat."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Hermes Mini usa el micrófono para dictar mensajes.",
          "speechRecognitionPermission": "Hermes Mini convierte tu voz en texto para enviarlo al chat.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "es",
            "en"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "./plugins/with-android-r8-optimize"
    ],
    "locales": {
      "es": "./locales/es.json",
      "en": "./locales/en.json"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "hermesUrl": "",
      "hermesApiKey": "",
      "router": {},
      "eas": {
        "projectId": "3767f9af-c5d9-4760-941f-ae7d30817c04"
      }
    },
    "owner": "chelo91"
  }
}
