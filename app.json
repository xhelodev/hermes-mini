{
  "expo": {
    "name": "Hermes",
    "slug": "hermes-apk",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "hermes",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hermes.apk"
    },
    "android": {
      "package": "com.hermes.apk",
      "adaptiveIcon": {
        "backgroundColor": "#09090b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Hermes usa tus fotos para adjuntarlas al chat.",
          "cameraPermission": "Hermes usa la cámara para adjuntar fotos al chat."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Hermes usa el micrófono para dictar mensajes.",
          "speechRecognitionPermission": "Hermes convierte tu voz en texto para enviarlo al chat.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
