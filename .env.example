# Expo no envía telemetría. En CI y en el perfil EAS preview también queda en 1.
EXPO_NO_TELEMETRY=1

# Opcional. Si tienen valor, el login los muestra; si no, los campos quedan vacíos.
# Copiá este archivo a .env. La clave va en .env o en .env.local: ninguno de los dos se commitea.
EXPO_PUBLIC_HERMES_URL=
EXPO_PUBLIC_HERMES_API_KEY=
